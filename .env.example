# ---------------------------------------------------------------- Database
# PostgreSQL (recommended for teams). Leave empty to use local SQLite (sdlc_pm.db).
# If the URL is set but unreachable, the app logs a warning and falls back to SQLite automatically.
DATABASE_URL=
# DATABASE_URL=postgresql+psycopg://sdlc:sdlc@localhost:5432/sdlc_pm

# Create tables on startup. Set to false if you manage the schema with `alembic upgrade head`.
AUTO_CREATE_TABLES=true

# ---------------------------------------------------------------- AI engine
# MOCK_AI=true runs the full workflow with a deterministic offline generator (no API key needed).
# Set MOCK_AI=false AND provide ANTHROPIC_API_KEY to generate with Claude.
MOCK_AI=true
ANTHROPIC_API_KEY=

CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (higher = more thorough, slower, more tokens)
CLAUDE_EFFORT=high
CLAUDE_MAX_TOKENS=64000
# Server-side refusal fallback (re-runs a declined request on a fallback model). Set false on platforms without it.
CLAUDE_ENABLE_FALLBACKS=true
